# 本地环境变量模板。复制为 .env 后按本机环境填写；.env 不会被 Git 提交。
# 在仓库根目录执行：set -a && . ./.env && set +a

# Spring Boot 开发环境
SPRING_PROFILES_ACTIVE=dev
FRAME_FORWARD_DB_URL=jdbc:mysql://127.0.0.1:3306/frame_forward
FRAME_FORWARD_DB_USERNAME=frame_forward
FRAME_FORWARD_DB_PASSWORD=replace-with-local-password
FRAME_FORWARD_MEDIA_ROOT=./var/media

# AI 工作流模型路由（未设置时使用 application.yml 中的默认值）
FRAME_FORWARD_QWEN_COURSE_MODEL=qwen3.7-plus
FRAME_FORWARD_QWEN_COACH_MODEL=qwen-plus
FRAME_FORWARD_QWEN_SCENE_MODEL=qwen3.8-max
FRAME_FORWARD_QWEN_IMAGE_MODEL=qwen-image-3.0-pro
FRAME_FORWARD_QWEN_DEFAULT_MODEL=qwen-plus

# Android Release 签名（仅在执行 release 构建时需要）
FRAME_FORWARD_RELEASE_STORE_FILE=release.keystore
FRAME_FORWARD_RELEASE_STORE_PASSWORD=replace-with-keystore-password
FRAME_FORWARD_RELEASE_KEY_ALIAS=replace-with-key-alias
FRAME_FORWARD_RELEASE_KEY_PASSWORD=replace-with-key-password
