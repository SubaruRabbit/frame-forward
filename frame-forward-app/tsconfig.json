{
  "extends": "@react-native/typescript-config",
  "compilerOptions": {
    "paths": {
      "@app": ["./src/app/index.ts"],
      "@app/*": ["./src/app/*"],
      "@features/*": ["./src/features/*"],
      "@domains/*": ["./src/domains/*"],
      "@components/*": ["./src/components/*"],
      "@hooks/*": ["./src/hooks/*"],
      "@utils/*": ["./src/utils/*"],
      "@theme/*": ["./src/theme/*"],
      "@services/*": ["./src/services/*"],
      "@contracts/*": ["./src/contracts/*"],
      "@config/*": ["./src/config/*"],
      "@i18n": ["./src/i18n/index.ts"],
      "@i18n/*": ["./src/i18n/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": ["**/node_modules", "**/Pods"]
}
