{
  "name": "FrameForwardApp",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "android:check": "cd android && ./gradlew :app:assembleDebug",
    "android:release:check": "cd android && ./gradlew :app:verifyReleaseSigning :app:bundleRelease",
    "android:bundle:check": "react-native bundle --platform android --dev false --entry-file index.js --bundle-output /tmp/frame-forward.android.bundle --assets-dest /tmp/frame-forward-android-assets",
    "ios": "react-native run-ios",
    "ios:prepare": "cd ios && pod install",
    "ios:check": "npm run ios:prepare && cd ios && xcodebuild -workspace FrameForwardApp.xcworkspace -scheme FrameForwardApp -configuration Release -sdk iphonesimulator -derivedDataPath build CODE_SIGNING_ALLOWED=NO build",
    "ios:bundle:check": "react-native bundle --platform ios --dev false --entry-file index.js --bundle-output /tmp/frame-forward.ios.bundle --assets-dest /tmp/frame-forward-ios-assets",
    "architecture:check": "node scripts/check-architecture.mjs --project",
    "architecture:test": "node scripts/check-architecture.mjs --fixtures",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix --max-warnings=0",
    "quality": "npm run format:check && npm run lint && npm run architecture:check && npm run typecheck && npm test -- --runInBand --no-watchman",
    "start": "react-native start",
    "test": "jest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^3.1.1",
    "@react-native-documents/picker": "^12.0.2",
    "@react-native/new-app-screen": "0.87.1",
    "react": "19.2.3",
    "react-native": "0.87.1",
    "react-native-keychain": "^10.0.0",
    "react-native-safe-area-context": "^5.5.2"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "babel-plugin-module-resolver": "5.0.2",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native-community/cli-platform-ios": "20.2.0",
    "@react-native/babel-preset": "0.87.1",
    "@react-native/eslint-config": "0.87.1",
    "@react-native/jest-preset": "0.87.1",
    "@react-native/metro-config": "0.87.1",
    "@react-native/typescript-config": "0.87.1",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "eslint": "^8.19.0",
    "eslint-config-prettier": "8.10.2",
    "jest": "^29.6.3",
    "prettier": "2.8.8",
    "react-test-renderer": "19.2.3",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">= 22.11.0"
  }
}
